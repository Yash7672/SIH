# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rakshak
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rakshak

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Hotlist / Demo ---
HOTLIST_CONFIRMATION_HOURS=24
DEMO_MODE=true

# --- Maps: event bus (redis is the default; kafka needs bootstrap servers) ---
EVENT_BUS=redis
KAFKA_BOOTSTRAP_SERVERS=
DETECTIONS_CONSUMER_GROUP=rakshak-analytics
DETECTIONS_MAX_ATTEMPTS=3
CONSUMER_BATCH_SIZE=200
CONSUMER_BLOCK_MS=1000

# --- Maps: analytics / OD flow ---
ENABLE_OD_FLOW=true
OD_PSEUDONYM_TTL_SECONDS=21600
# Leave empty to fall back to JWT_SECRET.
OD_PSEUDONYM_SECRET=
GEO_MAX_CELLS=5000
CAMERA_OFFLINE_AFTER_SECONDS=300

# --- Maps: synthetic demo traffic ---
# Unset follows DEMO_MODE. Set to false to run the API with no simulated data.
SIM_ENABLED=
SIM_RATE_HZ=1.0

# --- CORS ---
# scripts/start.ps1 rewrites this line with the PC's LAN IP added.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

# --- AI (optional local model paths) ---
AI_MODEL_PATH=
OCR_MODEL_PATH=

# --- Frontend ---
# scripts/start.ps1 rewrites the three values below to the PC's LAN IP so a
# phone on the same Wi-Fi can reach the API (localhost would mean the phone).
API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
