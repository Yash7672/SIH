# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rakshak
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rakshak

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Host port bindings (docker compose only) ---
# The Docker stack publishes PostgreSQL/Redis on the host for tooling. "local"
# mode (scripts/start.ps1 -Mode local) runs NATIVE PostgreSQL/Redis on the same
# ports, so the two stacks shadow each other and `localhost:5432`/`localhost:6379`
# answer from whichever bound first (the native services). Run one mode at a
# time, or move the container ports out of the way, e.g.:
#   POSTGRES_HOST_PORT=5433
#   REDIS_HOST_PORT=6380
# (The containerised backend always reaches its own services by name, so these
# only affect what host tooling sees.)
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Hotlist / Demo ---
HOTLIST_CONFIRMATION_HOURS=24
DEMO_MODE=true

# --- CORS ---
# scripts/start.ps1 rewrites this line with the PC's LAN IP added.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# In demo mode, also accept any private-LAN origin (10.x / 192.168.x /
# 172.16-31.x) so a phone on the same Wi-Fi can call the API without editing
# CORS_ORIGINS for every new IP. Has no effect outside demo mode.
CORS_ALLOW_PRIVATE_NETWORK=true

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

# --- AI (optional local model paths) ---
AI_MODEL_PATH=
OCR_MODEL_PATH=

# --- Per-character verifier ---
# Cross-checks every glyph of a plate read against models/char_cls.onnx before
# the verdict is decided. Set to false to fall back to the consensus-only path
# (then a STOLEN banner needs two agreeing reads instead of one).
CHAR_VERIFY=on

# --- Second plate reader (fast-plate-ocr ONNX) ---
# ai/plate_ocr.py is a small, plate-specialised recogniser that votes alongside
# RapidOCR in app/services/plate_reader.read_crop (and rescues the offline
# pipeline when RapidOCR finds nothing). Off-the-shelf weights are not
# India-trained, so they count as supporting evidence only.
#   auto (default) - use it when backend/models/fast-plate-ocr/ has the weights
#   on             - use it, downloading the weights if they are missing
#   off            - never use it
RAKSHAK_PLATE_OCR=auto
# Relative vote weight against one RapidOCR variant (default 0.6).
RAKSHAK_PLATE_OCR_WEIGHT=0.6

# --- Plate detector backend (open-image-models YOLOv9 end2end ONNX) ---
# ai/plate_detector.py is an ONNX-only plate detector (~4-8x faster than the
# ultralytics YOLOv8n .pt on the same box) and is now the default. It always
# falls back to the YOLOv8n .pt detector, then contours, when it is absent or
# finds nothing.
#   auto (default) - use it whenever backend/models/open-image-models/ has the weights
#   oim            - use it, downloading the weights if they are missing
#   legacy         - never use it; the YOLOv8n .pt detector, exactly as before
RAKSHAK_PLATE_DETECTOR=auto
# Input size of the ONNX detector: 256 | 384 | 416 | 512 | 640 (default 256;
# measured fastest and the only size that found the plate at every tested scale).
RAKSHAK_PLATE_DETECTOR_SIZE=256
# Min detection score (default 0.25, matches the legacy detector).
RAKSHAK_PLATE_DETECTOR_CONF=0.25

# --- Maps heatmap ---
# Time-decay constant for the stolen-sighting layer of GET /api/v1/geo/heat:
# a sighting HEAT_TAU_HOURS old counts as exp(-1) ~ 37% of a fresh one.
HEAT_TAU_HOURS=6.0

# --- Stream mode ---
# Fixed cameras are registered in this JSON file (no cameras table exists):
#   {"name": {"kind": "mjpeg|rtsp|usb|video", "url"|"device"|"path": ..., ...}}
# Relative paths resolve against the repo root. Shared by backend/stream_source.py
# and scripts/stream_camera.py.
STREAM_SOURCES_PATH=config/stream_sources.json

# --- Frontend ---
# scripts/start.ps1 rewrites the three values below to the PC's LAN IP so a
# phone on the same Wi-Fi can reach the API (localhost would mean the phone).
API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
