.env
node_modules/
__pycache__/
*.pyc
.venv/
venv/
data/uploads/
data/generated/*
!data/generated/.gitkeep
# STORAGE_LOCAL_PATH is "./data/uploads", so running pytest or uvicorn from
# backend/ creates a second uploads tree that the root rule above never matched.
backend/data/uploads/
dist/
# Transient output of `npx expo export --output-dir .tmp-export`; rebuild-only.
.tmp-export/
# Scratch logs from verification runs (pytest, the live-scan benchmark, start.bat).
# `.tmp*` specifically, because a launcher that redirects its own output passes
# those handles on to every child it starts - so these stay locked, and therefore
# undeletable, for exactly as long as the server it started is running.
.tmp_*.txt
# `scripts/render_live_view.py` writes annotated frames here. The older debug
# dumps under data/debug_out/ are committed, but these are regenerable from a
# fixture in the repo and would otherwise dirty the tree on every run.
data/debug_out/live_view_*.jpg
# `scripts/speed_check.py` writes its composite 1/4/6-vehicle scenes here so they
# can be looked at by eye after a run. Same reasoning as the debug dumps above:
# regenerable from data/test_plates/road_scene.jpg, and nothing reads them at
# runtime.
data/speed_scenes/
build/
*.log
.DS_Store
.idea/
.vscode/
*.tsbuildinfo
.expo/
android/
ios/
coverage/
.pytest_cache/
alembic/versions/__pycache__/
.env.local
.env.production
.rakshak/
logs/
