{
  "expo": {
    "name": "RAKSHAK Scanner",
    "slug": "rakshak-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "android": {
      "package": "in.gov.rakshak.scanner",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "RAKSHAK uses your camera to read vehicle number plates during demo scanning.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RAKSHAK uses your location to tag plate detections."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
