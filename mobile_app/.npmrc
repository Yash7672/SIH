# Expo SDK 58 pins react-native 0.88.0-rc.3. Prerelease versions do not satisfy
# a range like ">=0.65 <1.0" unless a comparator carries the same prerelease tag,
# so npm rejects the tree on packages that plainly support RN 0.88 - currently
# @react-native-async-storage/async-storage, which SDK 58 pins at 2.2.0.
# The range's intent is "RN 0.65 or newer", so this resolves the conflict rather
# than suppressing a real incompatibility.
legacy-peer-deps=true